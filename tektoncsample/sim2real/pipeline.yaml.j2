apiVersion: tekton.dev/v1
kind: Pipeline
metadata:
  name: sim2real-{{ phase }}
spec:
  params:
    - name: experimentId
      type: string
    - name: namespace
      type: string
    - name: sleepDuration
      type: string
      default: "30s"
  workspaces:
    - name: model-cache
    - name: hf-credentials
    - name: data-storage
  tasks:
    - name: download-model
      taskRef:
        name: download-model
      workspaces:
        - name: model-cache
          workspace: model-cache
        - name: hf-credentials
          workspace: hf-credentials
      params:
        - name: model
          value: "{{ stack.model.modelName }}"

    - name: deploy-gateway
      taskRef:
        name: deploy-gateway
      params:
        - name: experimentId
          value: "$(params.experimentId)"
        - name: namespace
          value: "$(params.namespace)"
        - name: config
          value: {{ stack.gateway.helmValues | tojson }}

    - name: deploy-gaie
      taskRef:
        name: deploy-gaie
      params:
        - name: modelLabel
          value: "sim2real-$(params.experimentId)"
        - name: config
          value: {{ gaie_config | tojson }}
        - name: namespace
          value: "$(params.namespace)"

    - name: deploy-model
      runAfter: ["download-model", "deploy-gaie"]
      taskRef:
        name: deploy-model
      workspaces:
        - name: model-cache
          workspace: model-cache
      params:
        - name: model
          value: "{{ stack.model.modelName }}"
        - name: modelLabel
          value: "sim2real-$(params.experimentId)"
        - name: namespace
          value: "$(params.namespace)"
        - name: config
          value: {{ stack.model.helmValues | tojson }}

    - name: pause-after-model-deploy
      runAfter: ["deploy-model"]
      taskRef:
        name: sleep
      params:
        - name: duration
          value: "$(params.sleepDuration)"

    - name: deploy-httproute
      runAfter: ["deploy-gateway", "deploy-gaie"]
      taskRef:
        name: deploy-httproute
      params:
        - name: namespace
          value: "$(params.namespace)"
        - name: gateway
          value: "$(tasks.deploy-gateway.results.gateway)"
        - name: inferencepool
          value: "$(tasks.deploy-gaie.results.inferencepool)"
        - name: modelLabel
          value: "sim2real-$(params.experimentId)"

    - __jinja__: |
        {% for wl in observe.workloads %}
        - name: run-workload-{{ wl.name | dns }}
          runAfter: ["pause-after-model-deploy", "deploy-httproute"]
          taskRef:
            name: run-workload-blis-observe
          workspaces:
            - name: data
              workspace: data-storage
          params:
            - name: endpoint
              value: "http://$(tasks.deploy-gateway.results.endpoint)/sim2real-$(params.experimentId)"
            - name: model
              value: "{{ stack.model.modelName }}"
            - name: workloadSpec
              value: {{ wl.spec | tojson }}
            - name: blisImage
              value: "{{ observe.image }}"
            - name: resultsDir
              value: "{{ phase }}/{{ wl.name }}"
        {% endfor %}
        - name: collect-results
          runAfter:
          {% for wl in observe.workloads %}
            - run-workload-{{ wl.name | dns }}
          {% endfor %}
          taskRef:
            name: collect-results
          workspaces:
            - name: data
              workspace: data-storage

  finally:
    - name: delete-httproute
      taskRef:
        name: delete-httproute
      params:
        - name: modelLabel
          value: "sim2real-$(params.experimentId)"
        - name: namespace
          value: "$(params.namespace)"
    - name: delete-model
      taskRef:
        name: delete-model
      params:
        - name: modelLabel
          value: "sim2real-$(params.experimentId)"
        - name: namespace
          value: "$(params.namespace)"
    - name: delete-gaie
      taskRef:
        name: delete-gaie
      params:
        - name: modelLabel
          value: "sim2real-$(params.experimentId)"
        - name: namespace
          value: "$(params.namespace)"
    - name: delete-gateway
      taskRef:
        name: delete-gateway
      params:
        - name: experimentId
          value: "$(params.experimentId)"
        - name: namespace
          value: "$(params.namespace)"
